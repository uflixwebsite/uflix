# Server Configuration
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_xxx
CLERK_SECRET_KEY=sk_test_or_sk_live_xxx

# Razorpay
RAZORPAY_KEY_ID=rzp_test_or_live_xxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_sender@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_sender@gmail.com
EMAIL_FROM_NAME=UFLIX Interio

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: invoice GSTIN
COMPANY_GSTIN=09AACCU6989R1Z1

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
